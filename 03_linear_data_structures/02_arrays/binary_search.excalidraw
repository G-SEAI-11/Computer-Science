      "type": "text",
      "x": 251.89976487064405,
      "y": 747.9140956895267,
      "width": 896,
      "height": 26.25,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1632824399,
      "version": 34,
      "versionNonce": 1588405345,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792137600521,
      "link": null,
      "locked": false,
      "text": "Weiter, solange left <= right. Nach einem Fehlvergleich ist die geprüfte Mitte ausgeschlossen.",
      "originalText": "Weiter, solange left <= right. Nach einem Fehlvergleich ist die geprüfte Mitte ausgeschlossen.",
