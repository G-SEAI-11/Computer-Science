      "isDeleted": false,
      "boundElements": [],
      "updated": 1794212206286,
      "link": null,
      "locked": false,
      "text": "Python ist die Basis; ein Terminal genügt.\nPakete und Frameworks selbst lernen und nutzen:\nerlaubt. Eine eigene Oberfläche darf das Menü ersetzen.\nPaketzweck, Version und Installation in der README\ndokumentieren.",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Python ist die Basis; ein Terminal genügt.\nPakete und Frameworks selbst lernen und nutzen:\nerlaubt. Eine eigene Oberfläche darf das Menü ersetzen.\nPaketzweck, Version und Installation in der README\ndokumentieren.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kXCSATCDOAXfmDvnRzrnW",
      "type": "text",
      "x": -94.23157021545057,
      "y": 1162.3637956430089,
      "width": 481.77978515625,
      "height": 105,
      "angle": 0,
