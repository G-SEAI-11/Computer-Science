      "locked": false,
      "fontSize": 24,
      "fontFamily": 2,
      "text": "def in_order(node, visited):\n    if node is None:\n        return\n    in_order(node.left, visited)\n    visited.append(node.value)\n    in_order(node.right, visited)",
      "originalText": "def in_order(node, visited):\n    if node is None:\n        return\n    in_order(node.left, visited)\n    visited.append(node.value)\n    in_order(node.right, visited)",
