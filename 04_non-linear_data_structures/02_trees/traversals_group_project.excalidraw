    {
      "id": "EFXd12sZBLAhQlPFddTrk",
      "type": "text",
      "x": 215.3644763763332,
      "y": -18.355998758363285,
      "width": 518,
      "height": 350,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "UceirUAgcv6__5sOXz8QG"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 915942249,
      "version": 88,
      "versionNonce": 1620409961,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793175418357,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 3,
      "text": "def pre_order(node, visited):\n    # Kein Knoten: Dieser Aufruf ist fertig.\n    if node is None:\n        return\n\n    # 1. Knoten, 2. links, 3. rechts.\n    visited.append(node.value)\n    pre_order(node.left, visited)\n    pre_order(node.right, visited)\n\n# Eigene Ergebnisliste für diesen Durchlauf.\npre_order_values = []\npre_order(bt.root, pre_order_values)\nprint(pre_order_values)",
      "originalText": "def pre_order(node, visited):\n    # Kein Knoten: Dieser Aufruf ist fertig.\n    if node is None:\n        return\n\n    # 1. Knoten, 2. links, 3. rechts.\n    visited.append(node.value)\n    pre_order(node.left, visited)\n    pre_order(node.right, visited)\n\n# Eigene Ergebnisliste für diesen Durchlauf.\npre_order_values = []\npre_order(bt.root, pre_order_values)\nprint(pre_order_values)",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1i"
    },
