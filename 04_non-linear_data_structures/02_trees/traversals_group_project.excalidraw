      "seed": 1000671207,
      "version": 93,
      "versionNonce": 1673050535,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793175461776,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 3,
      "text": "def in_order(node, visited):\n    # Kein Knoten: Dieser Aufruf ist fertig.\n    if node is None:\n        return\n\n    # 1. links, 2. Knoten, 3. rechts.\n    in_order(node.left, visited)\n    visited.append(node.value)\n    in_order(node.right, visited)\n\n# Eigene Ergebnisliste für diesen Durchlauf.\nin_order_values = []\nin_order(bt.root, in_order_values)\nprint(in_order_values)",
      "originalText": "def in_order(node, visited):\n    # Kein Knoten: Dieser Aufruf ist fertig.\n    if node is None:\n        return\n\n    # 1. links, 2. Knoten, 3. rechts.\n    in_order(node.left, visited)\n    visited.append(node.value)\n    in_order(node.right, visited)\n\n# Eigene Ergebnisliste für diesen Durchlauf.\nin_order_values = []\nin_order(bt.root, in_order_values)\nprint(in_order_values)",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b29"
    },
